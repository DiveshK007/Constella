# StellrFlow Frontend — environment variables
# Copy to .env.local and fill in. NEXT_PUBLIC_* values are exposed to the browser.

# Stellar network the app talks to: testnet or mainnet (default: testnet)
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Telegram bot API base URL
NEXT_PUBLIC_STELLAR_BOT_URL=http://localhost:3003

# ─── Product analytics — PostHog (posthog-js) ────────────────────────────────
# TODO: paste your PostHog project API key to enable analytics.
# Leave blank to disable PostHog entirely (capture calls become no-ops).
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog ingestion host (default: https://us.i.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Error monitoring — Sentry (@sentry/nextjs) ──────────────────────────────
# TODO: paste your Sentry project DSN to enable browser error reporting.
# Leave blank to disable Sentry entirely.
NEXT_PUBLIC_SENTRY_DSN=

# Note: @vercel/analytics needs no key — it collects automatically when the app
# is deployed on Vercel and is a no-op elsewhere.
