# StellrFlow Telegram Bot - Stellar Integration

# Required: Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Optional: Server port (default 3003)
PORT=3003

# Optional: Stellar network - testnet or mainnet
STELLAR_NETWORK=testnet

# Optional: Override Horizon URL (defaults based on STELLAR_NETWORK)
# HORIZON_URL=https://horizon-testnet.stellar.org

# Optional: Stellar RPC URL for Soroban (if using smart contracts)
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Optional: Bot-funded payments (requires secret key)
# STELLAR_SECRET_KEY=your_secret_key

# Security: API key for admin endpoints (/api/metrics, /api/users/addresses)
# In production, set this to a strong random string
# ADMIN_API_KEY=your_admin_api_key_here

# Security: Allowed frontend origin for CORS (default: http://localhost:3000)
# FRONTEND_URL=https://your-frontend.vercel.app

# AI Chatbot - OpenAI
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: AI response settings
# OPENAI_MODEL=gpt-3.5-turbo
# OPENAI_MAX_TOKENS=1024
# OPENAI_TEMPERATURE=0.3
# CHATBOT_REQUEST_TIMEOUT_MS=30000

# Error monitoring - Sentry (@sentry/node)
# TODO: paste your Sentry project DSN here to enable error reporting.
# Leave blank to disable Sentry entirely (the bot runs without it).
# SENTRY_DSN=
# Optional: fraction of transactions traced (0.0 - 1.0, default 0.1)
# SENTRY_TRACES_SAMPLE_RATE=0.1
